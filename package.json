{
  "name": "syncwatch",
  "version": "1.0.0",
  "description": "Premium synchronized watch-together streaming platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "watch": "node watch.js",
    "remote": "node watch.js",
    "check": "node --check server.js watch.js public/js/*.js",
    "pack": "repomix",
    "tokens": "repomix --token-count-tree"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "repomix": "^1.18.0"
  }
}
